# Prepare two groups of three qubits.
# Undo the gates, add X errors, then compare neighboring measurements.
QUBIT_COORDS(0, 0) 0
QUBIT_COORDS(1, 0) 1
QUBIT_COORDS(2, 0) 2
QUBIT_COORDS(0, 2) 3
QUBIT_COORDS(1, 2) 4
QUBIT_COORDS(2, 2) 5
R 0 1 2 3 4 5
H 0 3
S 0 3
CX 0 1 3 4
CX 1 2 4 5
TICK
CX 1 2 4 5
CX 0 1 3 4
S_DAG 0 3
H 0 3
TICK
X_ERROR(0.02) 0 1 2 3 4 5
M 0 1 2 3 4 5
DETECTOR(0.5, 0) rec[-6] rec[-5]
DETECTOR(1.5, 0) rec[-5] rec[-4]
DETECTOR(0.5, 2) rec[-3] rec[-2]
DETECTOR(1.5, 2) rec[-2] rec[-1]
OBSERVABLE_INCLUDE(0) rec[-6]
OBSERVABLE_INCLUDE(1) rec[-3]
